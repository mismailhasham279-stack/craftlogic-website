        "jsCode": "const targets = [\n  { niche: \"Mobile mechanic\", city: \"Plano TX\", country: \"us\" },\n  { niche: \"Handyman\", city: \"Lubbock TX\", country: \"us\" },\n  { niche: \"Tree trimming service\", city: \"Mesa AZ\", country: \"us\" },\n  { niche: \"Towing service\", city: \"Arlington TX\", country: \"us\" },\n  { niche: \"Junk removal\", city: \"Fort Worth TX\", country: \"us\" },\n  { niche: \"Pressure washing\", city: \"Garland TX\", country: \"us\" }\n];\n\nconst pick = targets[Math.floor(Math.random() * targets.length)];\n\nreturn [\n  {\n    json: {\n      niche: pick.niche,\n      city: pick.city,\n      country_code: pick.country,\n      search_query: `${pick.niche} in ${pick.city}`,\n      source: 'maps' // SerpAPI Maps guaranteed leads deta hai bina error ke\n    }\n  }\n];"
