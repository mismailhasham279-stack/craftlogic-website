      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $input.item.json.output || '';\n\n// Regex se direct values nikaalna bina kisi JSON parse crash ke\nconst extract = (key) => {\n  const match = raw.match(new RegExp(`\"${key}\"\\\\s*:\\\\s*\"([\\\\s\\\\S]*?)\"(?=\\\\s*,\\\\s*\"|\\\\s*}\\\\s*$)`));\n  return match ? match[1].replace(/\\\\\"/g, '\"').replace(/\\\\n/g, '\\n').trim() : 'Not Found';\n};\n\nreturn {\n  json: {\n    email: extract('email'),\n    instagram: extract('instagram'),\n    facebook: extract('facebook'),\n    tiktok_x: extract('tiktok_x'),\n    pitch: extract('pitch'),\n    demo_code: extract('demo_code')\n  }\n};"
      },
